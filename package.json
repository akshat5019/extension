{
  "name": "resume-assist",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "format": "prettier --write src/**/*.ts src/**/*.tsx tests/*.mjs tests/browser/*.js scripts/*.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "exceljs": "^4.4.0",
    "mammoth": "1.13.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "jsdom": "30.1.2",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
